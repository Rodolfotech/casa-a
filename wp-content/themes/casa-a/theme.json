{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "blanco", "color": "#FFFFFF", "name": "Blanco" },
				{ "slug": "gris-claro", "color": "#EBEBEB", "name": "Gris claro" },
				{ "slug": "negro", "color": "#000000", "name": "Negro" },
				{ "slug": "gris", "color": "#919191", "name": "Gris" },
				{ "slug": "taupe", "color": "#B1A28F", "name": "Taupe" },
				{ "slug": "gris-taupe", "color": "#A49A91", "name": "Gris taupe" }
			]
		},
		"typography": {
			"fontFamilies": [
				{ "slug": "serif", "fontFamily": "Georgia, 'Times New Roman', serif", "name": "Serif" }
			]
		},
		"layout": {
			"contentSize": "1100px",
			"wideSize": "1240px"
		}
	},
	"styles": {
		"color": {
			"background": "#FFFFFF",
			"text": "#000000"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--serif)"
		}
	}
}
